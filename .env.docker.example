APP_NAME="Efrumos.md"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=efrumos
DB_USERNAME=efrumos
DB_PASSWORD=efrumos

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local mail catcher (mailhog), not the real prod mail server/credentials.
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Real third-party integration keys from prod (safe to reuse locally — these
# identify the app to the provider, not a customer's data). DB/mail
# credentials above are deliberately NOT copied from prod.
RE_CAP_SITE=xxxx-xxxx
RE_CAP_SECRET=xxxx-xxxx
RE_CAP_MIN=0.4

GOOGLE_MAP_API=xxxx-xxxx

FACEBOOK_CLIENT_ID=xxxx-xxxx
FACEBOOK_CLIENT_SECRET=xxxx-xxxx

GOOGLE_CLIENT_ID=xxxx-xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx-xxxx

FACEBOOK_PIXEL_ID=xxxx-xxxx
FACEBOOK_PIXEL_ACCESS_TOKEN=xxxx-xxxx
FACEBOOK_TEST_EVENT_CODE=TEST7926

LOCATION_TESTING=false

# 1C integration — points at the solvex TEST database by default so local
# dev never touches the real production 1C. Only prod's .env should point
# at the /svx/ endpoint.
ONEC_WSDL_URL=http://agent.solvex.md/test_db/ws/ws_ef.1cws?wsdl

# TEMPORARY — see SoapOneCOrderGateway::checkStock() docblock. On here so
# local testing of the integration chain isn't blocked by whatever real
# stock number happens to be seeded for a given test order/SKU.
ONEC_FORCE_STOCK_OK=true
